# Backend API URL
# For local development with direct browser → backend: http://localhost:5001
# Recommended local dev: route /api and /socket.io through Vite proxy (vite.config.js → :5001):
#   VITE_USE_VITE_PROXY=true
#   (optional) VITE_NODE_API_URL=http://localhost:5001
# Then health/login/socket hit http://localhost:5174 via proxy instead of :5001 directly.
#
# VITE_NODE_API_URL=http://localhost:5001
VITE_NODE_API_URL=https://api.terracart.in 
VITE_FALLBACK_API_URL=https://terracart-backend.onrender.com

# Dev only: use same origin as Vite so requests use proxy (fixes ERR_CONNECTION_REFUSED when backend is OK but only reachable via proxy, or avoids mixed direct/proxy URLs).
# VITE_USE_VITE_PROXY=true

# Optional proxy target override for Vite dev server.
# Defaults:
# VITE_DEV_BACKEND_HOST=127.0.0.1
# VITE_DEV_BACKEND_PORT=5001
# You can also set a full target:
# VITE_DEV_BACKEND_TARGET=http://127.0.0.1:5001

# Customer Frontend URL (Required for QR code generation)
# For local development: http://localhost:5173
# For deployed frontend: Use your CloudFront or S3 website URL
VITE_CUSTOMER_BASE_URL=https://order.terracart.in

# Finances Panel (BOM, Inventory, Food Cost)
# Set to "true" to show Finances in the sidebar for cart/franchise/super admin
VITE_FEATURE_COSTING_ENABLED=true
